{
  "name": "esp-idf-web",
  "displayName": "ESP-IDF WEB",
  "description": "Espressif ESP-IDF Web extension for Webserial communication",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "publisher": "espressif",
  "icon": "media/espressif_icon.png",
  "galleryBanner": {
    "color": "#636363",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/espressif/vscode-esp-idf-web-extension.git"
  },
  "bugs": {
    "url": "https://github.com/espressif/vscode-esp-idf-web-extension/issues"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "arduino-esp32",
    "bluetooth",
    "ESP-IDF",
    "ESP-matter",
    "ESP",
    "Espressif",
    "ESP32",
    "ESP32-C2",
    "ESP32-C3",
    "ESP32-H2",
    "ESP32-P4",
    "ESP32-S2",
    "ESP32-S3",
    "esp32",
    "esp32c2",
    "esp32c3",
    "esp32c6",
    "esp32h2",
    "esp32s2",
    "esp32s3",
    "esp32p4",
    "matter",
    "iot",
    "wifi",
    "soc"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/project_description.json",
    "workspaceContains:**/sdkconfig",
    "workspaceContains:**/CMakeLists.txt"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "espIdfWeb.flash",
        "title": "ESP-IDF-Web Flash"
      },
      {
        "command": "espIdfWeb.monitor",
        "title": "ESP-IDF-Web Monitor"
      },
      {
        "command": "espIdfWeb.flashAndMonitor",
        "title": "ESP-IDF-Web Flash and Monitor"
      },
      {
        "command": "espIdfWeb.selectPort",
        "title": "ESP-IDF-Web Select serial port"
      },
      {
        "command": "espIdfWeb.disposePort",
        "title": "ESP-IDF-Web Disconnect serial port"
      },
      {
        "command": "espIdfWeb.eraseFlash",
        "title": "ESP-IDF-Web Erase flash"
      }
    ],
    "configuration": [
      {
        "title": "ESP-IDF Web",
        "properties": {
          "idfWeb.buildPath": {
            "type": "string",
            "default": "",
            "description": "Build directory for flash and monitor artifacts (flasher_args.json, project_description.json, binary files). Empty uses ${workspaceFolder}/build. Relative values are joined with the workspace folder.",
            "scope": "resource"
          },
          "idfWeb.flashBaudRate": {
            "type": "number",
            "default": 921600,
            "enum": [
              115200,
              230400,
              460800,
              921600
            ],
            "description": "Baud rate for flash command",
            "scope": "window"
          },
          "idfWeb.monitorBaudRate": {
            "type": "number",
            "default": 115200,
            "enum": [
              74880,
              115200
            ],
            "description": "Baud rate for monitor when no workspace folder or project_description.json is available",
            "scope": "window"
          },
          "idfWeb.enableStatusBarIcons": {
            "type": "boolean",
            "default": true,
            "description": "Show IDF-WEB status bar icons",
            "scope": "application"
          },
          "idfWeb.useWebUsbCh340": {
            "type": "boolean",
            "default": false,
            "description": "Select WCH CH340/CH341 adapters with WebUSB so flash can change baud in place. Leave off for CP2102, FTDI, ESP USB-JTAG, and CH343 (CDC).",
            "scope": "window"
          }
        }
      }
    ]
  },
  "scripts": {
    "test": "node scripts/run-web-tests.js",
    "pretest": "yarn run compile-web",
    "vscode:prepublish": "yarn run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "run-in-browser": "yarn compile-web && vscode-test-web --browserType=chromium --extensionDevelopmentPath=.",
    "package": "vsce package --yarn -o esp-idf-web-extension.vsix",
    "release": "vsce publish --yarn -p ${VS_MARKETPLACE_TOKEN} --packagePath esp-idf-web-extension.vsix",
    "open-vsx-release": "ovsx publish esp-idf-web-extension.vsix -p ${OPENVSX_MARKETPLACE_TOKEN}"
  },
  "devDependencies": {
    "@types/assert": "^1.5.10",
    "@types/crypto-js": "^4.2.2",
    "@types/mocha": "^10.0.6",
    "@types/vscode": "^1.90.0",
    "@types/w3c-web-serial": "^1.0.6",
    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-web": "^0.0.81",
    "assert": "^2.1.0",
    "eslint": "^8.57.0",
    "mocha": "^10.4.0",
    "ovsx": "^0.9.5",
    "process": "^0.11.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "vsce": "^2.15.0",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@types/w3c-web-usb": "^1.0.10",
    "crypto-js": "^4.2.0",
    "esptool-js": "^0.7.0",
    "web-serial-polyfill": "^1.0.15"
  }
}
